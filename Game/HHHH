def draw_menu():
    drawer.clear()
    buttons = [(-100, 120, "Start Game"), (-100, 50, "New Game"), 
               (-100, -20, "Save Game"), (-100, -90, "Documentation")]
    for x, y, text in buttons:
        # Box
        drawer.penup(); drawer.goto(x, y); drawer.color("#34495e"); drawer.begin_fill()
        for _ in range(2): drawer.forward(200); drawer.right(90); drawer.forward(50); drawer.right(90)
        drawer.end_fill()
        # Text
        drawer.goto(x + 100, y - 35); drawer.color("white")
        drawer.write(text, align="center", font=("Arial", 16, "bold"))
    screen.update()

def handle_menu_click(x, y):
    global game_state
    if game_state != "MENU": return
    
    if 120 < y < 170: # Start
        game_state = "PLAYING"; draw_game()
    elif 50 < y < 100: # New
        reset_current_stage(); game_state = "PLAYING"
    elif -20 < y < 30: # Save
        save_game()
    elif -90 < y < -40: # Docs
